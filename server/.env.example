# انسخ هذا الملف إلى .env
PORT=3000
# اربط الخادم محلياً افتراضياً؛ غيّره فقط عند الحاجة إلى وصول شبكي مباشر.
HOST=127.0.0.1
# مجلد البيانات الافتراضي هو server/data. غيّره فقط عند الحاجة.
DATA_DIR=
# مفتاح تشفير البيانات على القرص — إلزامي عند تشغيل بيانات حقيقية.
# ولّده بالأمر:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# احفظ نسخة منه خارج هذا الحاسوب: بدونه لا يمكن قراءة البيانات ولا النسخ الاحتياطية.
DATA_KEY=
# يبقى false للمفاتيح الجديدة. للتوافق المؤقت فقط مع تثبيت قديم استخدم عبارة سرية
# بدلاً من المفتاح العشوائي ذي 64 خانة hex؛ لا تفعّله عند إعداد خادم جديد.
ALLOW_LEGACY_PASSPHRASE_DATA_KEY=false
# عدد النسخ المحلية المحتفظ بها
MAX_BACKUPS=20
# مسار اختياري لنسخ مشفرة خارج مجلد الخادم (قرص خارجي أو مجلد مزامنة).
# اتركه فارغاً للتعطيل. نجاح النسخ إلى مجلد لا يثبت أنه خارج الجهاز؛
# تحقق من وجهة القرص/NAS وخدمة المزامنة، واحتفظ بالمفتاح منفصلاً.
# لا يُقبل مسار داخل DATA_DIR كوجهة خارجية.
BACKUP_EXTERNAL_DIR=
# للتجارب المحلية المؤقتة فقط؛ لا تفعّله في بيئة إنتاج.
ALLOW_PLAINTEXT_DATA=false
# الأصول المسموح لها باستدعاء API من المتصفح، مفصولة بفواصل.
CORS_ORIGINS=
# لتفعيل مزامنة Electron عبر خادم بعيد من file:// اضبط القيمة إلى true.
# يسمح ذلك أيضاً بأصول معتمة أخرى؛ اتركه false إن لم تكن هذه الميزة مطلوبة.
ALLOW_NULL_ORIGIN=false
# اضبطها true فقط خلف Cloudflare Tunnel أو reverse proxy موثوق.
TRUST_PROXY=false

# ---- واتساب تلقائي (WhatsApp Cloud API) — اختياري ----
# من لوحة Meta for Developers ← WhatsApp ← API Setup. لا تشارك هذه القيم مع أحد.
WA_TOKEN=
WA_PHONE_ID=
# سقف الرسائل اليومي لكل مساحة عمل
WA_DAILY_CAP=300
# لغة القوالب المعتمدة (ar للعربية)
WA_TPL_LANG=ar
# القوالب (اسم:عدد_المتغيرات). الإشعارات الابتدائية تتطلب قوالب معتمدة من Meta؛ اتركها فارغة لإرسال نص حر (يُقبل فقط خلال 24 ساعة من رد ولي الأمر)
# arrival/absence: {{1}} ولي الأمر  {{2}} اللاعب  {{3}} الفئة  {{4}} التاريخ  {{5}} المدرسة
# thanks: {{1}} ولي الأمر {{2}} اللاعب {{3}} الشهر {{4}} السنة {{5}} المدفوع {{6}} المتبقي {{7}} رقم الوصل {{8}} المدرسة
WA_TPL_ARRIVAL=
WA_TPL_ABSENCE=
WA_TPL_THANKS=

# ---- روابط الدعوات ----
# عنوان الخادم العام: إلزامي لتحقق الوصولات، واختياري للدعوات. استخدم أصل HTTPS دون /app.
PUBLIC_URL=https://sync.clubagaplus.ma

# ---- Android Trusted Web Activity (اختياري) ----
# يظهر التطبيق بملء الشاشة فقط بعد تطابق هذه القيم مع APK الموقّع.
# package ID يجب أن يطابق android/twa-manifest.json.
ANDROID_TWA_PACKAGE_NAME=com.malaabna.app
# بصمة شهادة SHA-256، وقد تضم بصمات متعددة مفصولة بفواصل (مثل مفتاح الرفع ومفتاح Play App Signing).
# استخرجها من ملف keystore المستخدم لتوقيع التطبيق؛ لا تضع كلمة مرور المفتاح هنا.
ANDROID_TWA_SHA256_CERT_FINGERPRINTS=

# ---- التحقق الإلكتروني من الوصولات ----
# يتطلب PUBLIC_URL أعلاه بعنوان HTTPS عام ثابت (الأصل فقط، دون /app).
# لا تؤخذ روابط التحقق من Host أو X-Forwarded-Host غير الموثوقين.
# يسمح HTTP على localhost فقط للتجارب المحلية؛ يبقى false في الإنتاج.
ALLOW_LOCAL_RECEIPT_VERIFICATION=false
